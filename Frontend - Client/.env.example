# Copy this file to .env.local (gitignored) and fill in your real values.

# Backend API URL (contoh: http://localhost:3000)
VITE_API_URL=http://localhost:3000

# Chart data — URL of the local mt5-bridge (see /mt5-bridge). Default below
# matches `uvicorn main:app --port 8000`; only change this if you run the
# bridge on a different port/host.
VITE_MT5_BRIDGE_URL=http://localhost:8000
