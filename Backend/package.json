{
  "name": "betrix-backend",
  "version": "1.0.0",
  "description": "Backend + AI orchestration layer for Betrix",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src-new/main.ts",
    "build": "tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "start": "node dist/main.js",
    "migrate": "tsx src-new/data/orm/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src-new --ext .ts",
    "lint:fix": "eslint src-new --ext .ts --fix"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.10.1",
    "figlet": "^1.11.3",
    "helmet": "^8.2.0",
    "module-alias": "^2.3.4",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.8.0",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.1",
    "xss": "^1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/pg": "^8.11.6",
    "@types/ua-parser-js": "^0.7.39",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.1",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.5"
  }
}
