# ===========================
# Betrix Backend - Environment Variables
# ===========================
# Variables marked with #NotNecessary are optional and have defaults or are not required for basic operation

# --- Server ---
PORT=3000 #NotNecessary
NODE_ENV=development #NotNecessary
FRONTEND_URL=http://localhost:5173 #NotNecessary
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174 #NotNecessary
LOG_LEVEL=info #NotNecessary
TRUST_PROXY_HOPS=1 #NotNecessary
SERVER_KEEPALIVE_TIMEOUT_MS=65000 #NotNecessary
SERVER_HEADERS_TIMEOUT_MS=66000 #NotNecessary

# --- Database --- 
DATABASE_URL=postgresql://user:password@localhost:5432/betrix
DB_POOL_MAX=20 #NotNecessary
DB_STATEMENT_TIMEOUT_MS=10000 #NotNecessary
DB_QUERY_TIMEOUT_MS=15000 #NotNecessary

# --- Redis Cache ---
UPSTASH_REDIS_REST_URL=https://your_upstash_url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# --- Authentication & Security ---
JWT_SECRET=your_super_secret_jwt_key_here
DEVICE_ENFORCEMENT=false #NotNecessary
RATE_LIMIT_PER_MINUTE=30 #NotNecessary
RATE_LIMIT_PER_USER_PER_MINUTE=30 #NotNecessary
RATE_LIMIT_REGISTER_PER_HOUR=5 #NotNecessary
SESSION_LOOKUP_TIMEOUT_MS=5000 #NotNecessary
REQUIRE_EMAIL_VERIFICATION=false #NotNecessary

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id_here #NotNecessary
GOOGLE_CLIENT_SECRET=your_google_client_secret_here #NotNecessary
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback #NotNecessary

# --- AI Gateway ---
AI_BASE_URL=https://gateway.example.com/v1
AI_API_KEY=your_ai_api_key_here
MODEL_CHEAP=your-cheap-model
MODEL_BALANCED=your-balanced-model
MODEL_DEEP=your-deep-model
MODEL_CHEAP_MAX_TOKENS=2048 #NotNecessary
MODEL_BALANCED_MAX_TOKENS=4096 #NotNecessary
MODEL_DEEP_MAX_TOKENS=8192 #NotNecessary
AI_REQUEST_TIMEOUT_MS=30000 #NotNecessary
AI_STREAM_TIMEOUT_MS=60000 #NotNecessary
AI_DEBUG_LOGGING=false #NotNecessary
SSE_HEARTBEAT_INTERVAL_MS=15000 #NotNecessary

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com #NotNecessary
SMTP_PORT=587 #NotNecessary
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Betrix #NotNecessary

# --- External APIs & Broker Integrations ---
FINNHUB_API_KEY=your_finnhub_api_key_here #NotNecessary
FINNHUB_POLLING_INTERVAL_SEC=10 #NotNecessary

# MT5 Bridge
MT5_BRIDGE_URL=127.0.0.1:8890 #NotNecessary
MT5_WS_URL=ws://127.0.0.1:8890 #NotNecessary
MT5_HTTP_URL=http://127.0.0.1:8890 #NotNecessary
MT5_POLLING_INTERVAL_SEC=10 #NotNecessary
MT5_BROKER_UTC_OFFSET=3 #NotNecessary
MT5_TRACK_PRICES=true #NotNecessary
MT5_TRACK_OHLC=true #NotNecessary
MT5_TRACK_MBOOK=false #NotNecessary
MT5_TRACK_CALENDAR=true #NotNecessary
MT5_TRACKING_SYMBOLS=EURUSD, GBPUSD, USDJPY, USDCAD, AUDUSD, NZDUSD, USDCHF, XAUUSD, XAGUSD, XTIUSD, BTCUSD, ETHUSD #NotNecessary
