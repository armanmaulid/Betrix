# ==========================================
# 1. CORE SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ==========================================
# 2. DATABASE & CACHING (REDIS)
# ==========================================
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=requires
UPSTASH_REDIS_REST_URL=https://<your_upstash_url>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your_upstash_token>

# ==========================================
# 3. AUTHENTICATION & SECURITY
# ==========================================
# Replace JWT_SECRET with a cryptographically secure 256-bit key in production
JWT_SECRET=your_jwt_secret_key_here
DEVICE_ENFORCEMENT=false

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ==========================================
# 4. AI GATEWAY (9Router / Genfity)
# ==========================================
AI_BASE_URL=https://gateway.dahono.com/v1
AI_API_KEY=your_ai_api_key_here

MODEL_CHEAP=LLM-Model-Here
MODEL_BALANCED=LLM-Model-Here
MODEL_DEEP=LLM-Model-Here

# ==========================================
# 5. MAILER (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Betrix"

# ==========================================
# 6. EXTERNAL SERVICES & MISC
# ==========================================
FAQ_CACHE_TTL_DAYS=7
FINNHUB_API_KEY=your_finnhub_api_key_here

# Offset UTC broker MT5 (dalam jam). Contoh: 3 untuk UTC+3, 2 untuk UTC+2.
# Dipakai untuk menghitung kapan D1 candle reset (00:00 waktu broker).
MT5_BROKER_UTC_OFFSET=3
